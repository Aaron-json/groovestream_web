{
  "name": "@groovestream/frontend",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @groovestream/web",
    "gen-api": "npm run gen-api --workspace @groovestream/api",
    "check": "npm run check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspace @groovestream/web"
  },
  "overrides": {
    "js-yaml@4.2.0": "4.3.1"
  }
}
