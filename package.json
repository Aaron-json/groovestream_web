{
  "name": "@groovestream/frontend",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @groovestream/web",
    "dev:mobile": "npm run start --workspace @groovestream/mobile",
    "dev:mobile:ios": "npm run ios --workspace @groovestream/mobile",
    "dev:mobile:ios:device": "npm run ios --workspace @groovestream/mobile -- --device",
    "dev:mobile:android": "npm run android --workspace @groovestream/mobile",
    "dev:mobile:android:device": "npm run android --workspace @groovestream/mobile -- --device",
    "gen-api": "npm run gen-api --workspace @groovestream/api",
    "check": "npm run check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build:web": "npm run build --workspace @groovestream/web"
  },
  "overrides": {
    "js-yaml@4.2.0": "4.3.1"
  }
}
